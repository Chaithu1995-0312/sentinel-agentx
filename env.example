# Sentinel — local env only. Copy to .env and fill. NEVER commit .env.

# --- Ports ---
MARKET_INGEST_PORT=8001
STRATEGY_ENGINE_PORT=8002
RISK_GUARD_PORT=8003
PAPER_BROKER_PORT=8004
AGENT_ORCHESTRATOR_PORT=8005
JOURNAL_API_PORT=8006
DASHBOARD_UI_PORT=8010

# --- Risk / kill switch (fail-closed) ---
KILL_SWITCH_DEFAULT=true
KILL_SWITCH_PATH=./data/kill_switch.json
RISK_MAX_POSITION_PCT=0.05
RISK_STOP_LOSS_PCT=0.02
RISK_DAILY_LOSS_LIMIT=0.03
RISK_MAX_TRADES_PER_DAY=10
RISK_MIN_RR=1.5
PAPER_STARTING_CASH=100000

# --- LLM (optional; templates used if key missing; hard daily cap) ---
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash
LLM_DAILY_TOKEN_CAP=50000

# --- Service URLs (localhost for Python/uvicorn; no Docker) ---
MARKET_INGEST_URL=http://127.0.0.1:8001
STRATEGY_ENGINE_URL=http://127.0.0.1:8002
RISK_GUARD_URL=http://127.0.0.1:8003
PAPER_BROKER_URL=http://127.0.0.1:8004
JOURNAL_API_URL=http://127.0.0.1:8006
AGENT_ORCHESTRATOR_URL=http://127.0.0.1:8005

# --- Seeds (relative to repo root when running locally) ---
SEED_OHLCV_PATH=./seeds/ohlcv_sample.csv
SEED_REGIME_PATH=./seeds/ohlcv_regimes.json
SEED_NEWS_PATH=./seeds/news_sample.json

# --- Persistence ---
JOURNAL_PATH=./data/journal.jsonl
BROKER_STATE_PATH=./data/broker_state.json
RISK_STATE_PATH=./data/risk_state.json

# --- Strategy ---
SMA_FAST=5
SMA_SLOW=15
RSI_PERIOD=2
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
BB_PERIOD=20
BB_K=2
STRATEGY_DD_PENALTY=0.5
FEE_BPS=10
SLIPPAGE_BPS=5
SWITCH_MARGIN=0.02
NEWS_LOOKBACK_DAYS=14
